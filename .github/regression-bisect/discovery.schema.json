{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed issue-linked regression discovery registration (not execution approval)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "issueNumber", "commentId", "checkpointAnchorSha", "bootstrapDigest", "provisionDeadline", "workflowPath", "workflowGeneration"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": { "const": "dotnet/fsharp" },
    "issueNumber": { "type": "integer", "minimum": 1 },
    "commentId": { "type": "integer", "minimum": 1 },
    "checkpointAnchorSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "bootstrapDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "provisionDeadline": { "type": "string", "format": "date-time" },
    "workflowPath": { "const": ".github/workflows/regression-bisect-discovery.yml" },
    "workflowGeneration": { "type": "integer", "minimum": 1 }
  }
}
