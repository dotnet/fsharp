<Project InitialTargets="ValidateVSScheduledMinorVersion">
  <!-- Nominal snap: second Tuesday minus 11 calendar days, noon Pacific; apply after 24 hours. -->
  <PropertyGroup>
    <VSMinorVersionIsHeuristic>false</VSMinorVersionIsHeuristic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UseVSScheduledMinorVersion)' == 'true' and '$(VSBuildTimestampUtc)' != ''">
    <_VSOffsetTimestamp>$([System.Text.RegularExpressions.Regex]::Replace('$(VSBuildTimestampUtc)', 'Z$', '+00:00'))</_VSOffsetTimestamp>
    <_VSBuildTicks>$([System.DateTime]::ParseExact('$(_VSOffsetTimestamp)', 'yyyy-MM-ddTHH:mm:ss.FFFFFFFzzz', $([System.Globalization.CultureInfo]::GetCultureInfo(''))).ToUniversalTime().Ticks)</_VSBuildTicks>
    <!-- Version-number calibration, not a snap date: October 2026's Patch Tuesday cycle maps to minor 13. -->
    <_VSMinorBaseYear>2026</_VSMinorBaseYear>
    <_VSMinorBaseMonth>10</_VSMinorBaseMonth>
    <_VSMinorBase>13</_VSMinorBase>
    <!-- Effective date is Patch Tuesday minus 10 days, at noon Pacific. Look ahead to include month-crossing snaps. -->
    <_VSNominalMonth>$([System.DateTime]::new($(_VSBuildTicks)).AddDays(10).ToString('yyyy-MM-01', $([System.Globalization.CultureInfo]::GetCultureInfo(''))))</_VSNominalMonth>
    <_VSMonthStart>$([System.DateTime]::ParseExact('$(_VSNominalMonth)', 'yyyy-MM-dd', $([System.Globalization.CultureInfo]::GetCultureInfo(''))))</_VSMonthStart>
    <_VSFirstWeekday>$([System.Convert]::ToInt32($([System.DateTime]::Parse('$(_VSMonthStart)').DayOfWeek)))</_VSFirstWeekday>
    <_VSPatchTuesdayOffset>$([MSBuild]::Add(7, $([MSBuild]::Modulo($([MSBuild]::Subtract(9, $(_VSFirstWeekday))), 7))))</_VSPatchTuesdayOffset>
    <_VSNominalSnap>$([System.DateTime]::Parse('$(_VSMonthStart)').AddDays($(_VSPatchTuesdayOffset)).AddDays(-11).AddHours(12))</_VSNominalSnap>
    <!-- US Pacific DST runs from the second Sunday in March to the first Sunday in November.
         Snaps are Fridays, so neither the noon snap nor its 24-hour delay crosses a DST change. -->
    <_VSSnapYear>$([System.DateTime]::Parse('$(_VSNominalSnap)').Year)</_VSSnapYear>
    <_VSMarchWeekday>$([System.Convert]::ToInt32($([System.DateTime]::new($(_VSSnapYear), 3, 1).DayOfWeek)))</_VSMarchWeekday>
    <_VSNovemberWeekday>$([System.Convert]::ToInt32($([System.DateTime]::new($(_VSSnapYear), 11, 1).DayOfWeek)))</_VSNovemberWeekday>
    <_VSDaylightStart>$([System.DateTime]::new($(_VSSnapYear), 3, 1).AddDays($([MSBuild]::Add(7, $([MSBuild]::Modulo($([MSBuild]::Subtract(7, $(_VSMarchWeekday))), 7))))).Ticks)</_VSDaylightStart>
    <_VSDaylightEnd>$([System.DateTime]::new($(_VSSnapYear), 11, 1).AddDays($([MSBuild]::Modulo($([MSBuild]::Subtract(7, $(_VSNovemberWeekday))), 7))).Ticks)</_VSDaylightEnd>
    <_VSPacificOffset>8</_VSPacificOffset>
    <_VSPacificOffset Condition="$([System.DateTime]::Parse('$(_VSNominalSnap)').Ticks) &gt;= $(_VSDaylightStart) and $([System.DateTime]::Parse('$(_VSNominalSnap)').Ticks) &lt; $(_VSDaylightEnd)">7</_VSPacificOffset>
    <_VSNominalTicks>$([System.DateTime]::Parse('$(_VSNominalSnap)').AddHours($(_VSPacificOffset)).AddHours(24).Ticks)</_VSNominalTicks>
    <_VSMonthDifference>$([MSBuild]::Add($([MSBuild]::Multiply($([MSBuild]::Subtract($([System.DateTime]::Parse('$(_VSMonthStart)').Year), $(_VSMinorBaseYear))), 12)), $([MSBuild]::Subtract($([System.DateTime]::Parse('$(_VSMonthStart)').Month), $(_VSMinorBaseMonth)))))</_VSMonthDifference>
    <!-- Compare as Int64: MSBuild numeric conditions round large tick values to doubles. -->
    <_VSMonthDifference Condition="$([System.Int64]::Parse('$(_VSBuildTicks)').CompareTo($([System.Int64]::Parse('$(_VSNominalTicks)')))) &lt; 0">$([MSBuild]::Subtract($(_VSMonthDifference), 1))</_VSMonthDifference>
    <_VSSelectedMinor>$([MSBuild]::Add($(_VSMinorBase), $(_VSMonthDifference)))</_VSSelectedMinor>
    <_VSValidationError />
    <_VSValidationError Condition="'$(VSMajorVersion)' != '18'">The VS minor heuristic covers major 18 only. Update the version-number calibration.</_VSValidationError>
    <_VSValidationError Condition="$(_VSSelectedMinor) &lt; 0">The computed VS minor is below 0. Check VSBuildTimestampUtc and the version-number calibration.</_VSValidationError>
    <_VSValidationError Condition="$(_VSSelectedMinor) &gt; 65534">The computed VS minor exceeds 65534. Check VSBuildTimestampUtc and the version-number calibration.</_VSValidationError>
    <!-- A failing property function rejects invalid inputs even when -getProperty skips all targets. -->
    <_VSValidationResult Condition="'$(_VSValidationError)' != ''">$([System.Int32]::Parse('$(_VSValidationError)'))</_VSValidationResult>
    <VSMinorVersion>$(_VSSelectedMinor)</VSMinorVersion>
    <VSMinorVersionIsHeuristic>true</VSMinorVersionIsHeuristic>
    <MSBuildWarningsNotAsErrors>$(MSBuildWarningsNotAsErrors);FSVS1001</MSBuildWarningsNotAsErrors>
  </PropertyGroup>

  <Target Name="ValidateVSScheduledMinorVersion"
          Condition="'$(UseVSScheduledMinorVersion)' == 'true' and '$(VSBuildTimestampUtc)' != ''">
    <Warning Code="FSVS1001"
             Text="VS minor $(VSMinorVersion) is estimated using Patch Tuesday minus 11 calendar days at noon Pacific, plus 24 hours. Actual VS snaps may differ." />
  </Target>
</Project>
