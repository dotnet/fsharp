<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>use</Title>
      <Shortcut>use</Shortcut>
      <Description>Code snippet for a use binding</Description>
      <Author>Microsoft Corporation</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>name</ID>
          <ToolTip>Name bound to the resource</ToolTip>
          <Default>resource</Default>
        </Literal>
        <Literal>
          <ID>expression</ID>
          <ToolTip>Expression producing the resource</ToolTip>
          <Default>resource</Default>
        </Literal>
      </Declarations>
      <Code Language="FSharp"><![CDATA[use $name$ = $expression$
$end$]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
