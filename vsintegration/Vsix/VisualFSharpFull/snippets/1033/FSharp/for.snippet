<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>for</Title>
      <Shortcut>for</Shortcut>
      <Description>Code snippet for a for loop over a sequence</Description>
      <Author>Microsoft Corporation</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
        <SnippetType>SurroundsWith</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>item</ID>
          <ToolTip>Iteration variable</ToolTip>
          <Default>item</Default>
        </Literal>
        <Literal>
          <ID>collection</ID>
          <ToolTip>Sequence to iterate</ToolTip>
          <Default>collection</Default>
        </Literal>
      </Declarations>
      <Code Language="FSharp"><![CDATA[for $item$ in $collection$ do
    $selected$$end$]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
