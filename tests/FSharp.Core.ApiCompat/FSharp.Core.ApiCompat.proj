<!--
  Assembly-level ApiCompat gate: the shipped net-TFM FSharp.Core must have the identical public surface to
  netstandard2.1. Uses the SDK-registered ValidateAssembliesTask (not Arcade, not SDK package validation whose
  strict knob is inert here). EnableStrictMode fails a member add/remove in either direction; AttributesMustMatch
  stays OFF so the polyfills' internal->public-BCL attribute shift passes with an EMPTY suppression set.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A TFM is required for SDK evaluation, but nothing is compiled or restored. -->
    <TargetFramework>$(FSharpNetCoreProductTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
  </PropertyGroup>

  <PropertyGroup>
    <_FSharpCoreBinDir>$(MSBuildThisFileDirectory)..\..\artifacts\bin\FSharp.Core\$(Configuration)</_FSharpCoreBinDir>
    <_FSharpCoreNsAssembly>$([MSBuild]::NormalizePath('$(_FSharpCoreBinDir)', 'netstandard2.1', 'FSharp.Core.dll'))</_FSharpCoreNsAssembly>
    <_FSharpCoreNetAssembly>$([MSBuild]::NormalizePath('$(_FSharpCoreBinDir)', '$(FSharpCoreShippedNetTargetFramework)', 'FSharp.Core.dll'))</_FSharpCoreNetAssembly>
  </PropertyGroup>

  <Target Name="ValidateFSharpCoreApiIdentity" DependsOnTargets="CollectApiCompatInputs">
    <Error Condition="!Exists('$(_FSharpCoreNsAssembly)')"
           Text="ApiCompat gate: netstandard2.1 FSharp.Core not found at '$(_FSharpCoreNsAssembly)'. Build FSharp.Core ($(Configuration)) first." />
    <Error Condition="!Exists('$(_FSharpCoreNetAssembly)')"
           Text="ApiCompat gate: $(FSharpCoreShippedNetTargetFramework) FSharp.Core not found at '$(_FSharpCoreNetAssembly)'. Build FSharp.Core ($(Configuration)) first." />

    <ValidateAssembliesTask
        LeftAssemblies="$(_FSharpCoreNsAssembly)"
        RightAssemblies="$(_FSharpCoreNetAssembly)"
        EnableStrictMode="true"
        GenerateSuppressionFile="false"
        RoslynAssembliesPath="$(RoslynAssembliesPath)" />
  </Target>

</Project>
