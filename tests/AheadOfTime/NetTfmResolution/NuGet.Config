<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <!-- VerifyNetResolution.fsx stages the freshly built FSharp.Core nupkg into this clean, flat
             local feed before restoring. A depth-0 flat folder resolves deterministically on every
             OS/CI, and packageSourceMapping restricts local to FSharp.Core. -->
        <add key="localPackages" value="obj/localfeed" />
        <add key="remote" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-public/nuget/v3/index.json" />
    </packageSources>
    <disabledPackageSources>
        <clear />
    </disabledPackageSources>
    <fallbackPackageFolders>
        <clear />
    </fallbackPackageFolders>
    <packageSourceMapping>
        <!-- Force FSharp.Core to come ONLY from the local build; a stale/missing local asset
             cannot be silently satisfied from nuget.org. Everything else (targeting/runtime
             packs, etc.) resolves from the public feed. -->
        <packageSource key="localPackages">
            <package pattern="FSharp.Core" />
        </packageSource>
        <packageSource key="remote">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
