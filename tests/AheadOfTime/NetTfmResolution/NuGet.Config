<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <!-- VerifyNetResolution.fsx stages the freshly built FSharp.Core nupkg into this flat local
             feed before restoring; a depth-0 folder resolves deterministically on every OS/CI. -->
        <add key="localPackages" value="obj/localfeed" />
        <add key="remote" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-public/nuget/v3/index.json" />
    </packageSources>
    <disabledPackageSources>
        <clear />
    </disabledPackageSources>
    <fallbackPackageFolders>
        <clear />
    </fallbackPackageFolders>
    <packageSourceMapping>
        <!-- FSharp.Core resolves ONLY from the local build (a stale/missing local asset can't be
             satisfied from nuget.org); everything else resolves from the public feed. -->
        <packageSource key="localPackages">
            <package pattern="FSharp.Core" />
        </packageSource>
        <packageSource key="remote">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
