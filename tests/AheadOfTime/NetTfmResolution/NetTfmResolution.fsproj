<Project Sdk="Microsoft.NET.Sdk">

  <!-- Consumer for VerifyNetResolution.fsx: targets EXACTLY the pinned shipped net TFM (never a literal). -->
  <Import Project="$(MSBuildThisFileDirectory)../../../eng/TargetFrameworks.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(FSharpCoreShippedNetTargetFramework)</TargetFramework>
    <LangVersion>preview</LangVersion>
    <RollForward>Major</RollForward>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="$(FSharpCoreTestVersion)" />
  </ItemGroup>

</Project>
